#!/bin/sh

# Auto-push the current branch after each local commit.
branch="$(git rev-parse --abbrev-ref HEAD)"

if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then
  exit 0
fi

echo "Auto push: origin/$branch"
git push origin "$branch" || exit 0

# Auto-deploy only for main branch.
if [ "$branch" = "main" ]; then
  if command -v vercel >/dev/null 2>&1; then
    echo "Auto deploy: vercel --prod"
    vercel deploy --prod --yes
  else
    echo "Auto deploy skipped: vercel CLI not found."
  fi
fi
