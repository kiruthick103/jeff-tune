# OpenRouter API Key - get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Database (for local run without Docker)
# With Docker: use docker-compose, DATABASE_URL is set automatically
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jeff_chat

# Optional: Port (default 3000)
PORT=3000
